{
  "name": "uns-bridge-opcua",
  "version": "2.0.1",
  "private": true,
  "description": "UNS OpenHub add-on for browsing OPC UA servers and mapping nodes into UNS.",
  "license": "MIT",
  "author": "Aljo\u0161a Vister",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uns-openhub/uns-bridge-opcua.git"
  },
  "homepage": "https://github.com/uns-openhub/uns-bridge-opcua#readme",
  "bugs": {
    "url": "https://github.com/uns-openhub/uns-bridge-opcua/issues"
  },
  "unsDatahub": {
    "schemaVersion": 1,
    "kind": "addon",
    "controllerCompatibility": ">=2 <3"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "runtime-state.manifest.json",
    "runtime-config.schema.json"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "build": "pnpm run clean && tsc -p tsconfig.json && node scripts/generate-runtime-state-schema.mjs",
    "dev": "node --env-file-if-exists=.env ./node_modules/tsx/dist/cli.mjs watch src/index.ts",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate-config-schema": "node ./node_modules/@uns-kit/core/dist/tools/generate-config-schema.js",
    "generate-codegen": "graphql-code-generator --require dotenv/config --config codegen.ts",
    "sync-uns-schema": "node ./node_modules/@uns-kit/core/dist/tools/sync-uns-schema.js",
    "verify": "pnpm run typecheck && pnpm run lint && pnpm run test && pnpm run build",
    "check-release-version": "node scripts/check-release-version.mjs",
    "test": "tsx --test src/api/*.test.ts src/opcua/*.test.ts src/runtime/*.test.ts"
  },
  "dependencies": {
    "@uns-kit/api": "^3.0.21",
    "@uns-kit/bridge-core": "^3.0.1",
    "@uns-kit/core": "^3.0.21",
    "node-opcua": "^2.175.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.0",
    "eslint": "^9.39.4",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0"
  },
  "pnpm": {
    "overrides": {
      "@smithy/config-resolver": "4.6.12",
      "esbuild": "0.28.1",
      "fast-xml-parser": "5.10.1",
      "lodash": "4.18.1",
      "protobufjs": "7.6.5",
      "simple-git": "3.36.0",
      "thrift": "0.23.0",
      "underscore": "1.13.8",
      "undici": "7.28.0",
      "uuid": "11.1.1"
    }
  },
  "packageManager": "pnpm@10.30.3"
}
